# Copia este archivo como .env y rellena los valores.
# .env nunca debe subirse a git (ya está en .gitignore).

# App
PORT=4000
NODE_ENV=development

# Base de datos (Postgres)
# Si usas el docker-compose.yml de la raiz del workspace, PGHOST debe ser "db"
# y DATABASE_URL debe apuntar a "db" en vez de "localhost".
PGHOST=localhost
PGPORT=5432
PGDATABASE=voluntalia-test
PGUSER=postgres
PGPASSWORD=

DATABASE_URL=postgres://postgres:<password>@localhost:5432/voluntalia-test

# JWT
ACCESS_TOKEN_SECRET=pon_aqui_un_secreto_largo_y_unico
ACCESS_TOKEN_TTL=1h
REFRESH_TOKEN_SECRET=otro_secreto_largo_y_unico
REFRESH_TOKEN_TTL=30d

# Gestion de archivos (ver Manage_files_configuration.md)
# FILES_PATH es la URL publica/interna desde la que se sirven los archivos
# (el contenedor file-server). PIVOT es la ruta local donde Multer guarda los
# archivos subidos antes de que file-server los sirva desde el mismo volumen.
FILES_PATH=http://file-server/files
PIVOT=C:\tmp\files

# SendGrid (opcional — sin esto, el envio de emails queda deshabilitado sin
# romper la app; ver Sendgrid_configuration.md para la guia completa)
# SENDGRID_API_KEY=SG.your_api_key_here
# SENDGRID_FROM_EMAIL=noreply@voluntalia.org
# FRONTEND_URL=http://localhost:8080
# EMAIL_RATE_LIMIT_MAX=5
# EMAIL_RATE_LIMIT_WINDOW_MINUTES=15
